# GEMINI_API_KEY: Required server-side for Gemini AI API calls (AI Tutor, Scan Notes, Quiz, Analysis).
# Configure this in Google AI Studio Secrets and in Vercel Project Settings > Environment Variables.
GEMINI_API_KEY=

# APP_URL: The public URL where this application is hosted.
APP_URL=

# SMTP Email Configuration for sending Contact Form submissions
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Destination email address where you want to receive the contact form submissions
CONTACT_RECIPIENT_EMAIL=studyweb908@gmail.com

# Supabase Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional server-side service role key for backend workspace sync on Vercel
SUPABASE_SERVICE_ROLE_KEY=
